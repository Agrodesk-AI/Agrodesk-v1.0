# Copy to .env. Never commit real secrets.
ENV=local
# App/API/workers connect as agrodesk_app (NOSUPERUSER NOBYPASSRLS) so RLS is enforced.
DATABASE_URL=postgresql+asyncpg://agrodesk_app:agrodesk_app@localhost:5433/agrodesk
# Alembic connects as the owner role (DDL). Never point the app at this.
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://agrodesk:agrodesk@localhost:5433/agrodesk
# Tests: app role against the test DB (migrate it with the owner URL first).
TEST_DATABASE_URL=postgresql+asyncpg://agrodesk_app:agrodesk_app@localhost:5433/agrodesk_test
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me
# Vendors behind interfaces (open decisions, see AGRODESK_PROJECT.md L.3)
WHATSAPP_BSP=
SMS_PROVIDER=
LLM_PROVIDER=
EMBEDDING_PROVIDER=
LANGFUSE_HOST=
SENTRY_DSN=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
